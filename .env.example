# claude_agent plugin — environment variables for claude_agent_sdk
# Copy to .env and fill in your credentials.

# Claude / Anthropic-compatible API endpoint
INSTALL_METHOD=remote
REMOTE_INSTALL_URL=
REMOTE_INSTALL_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_SONNET_MODEL_NAME=deepseek-v4-pro
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1M]
ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=deepseek-v4-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1M]
ANTHROPIC_DEFAULT_FABLE_MODEL_NAME=deepseek-v4-pro
ANTHROPIC_DEFAULT_FABLE_MODEL=deepseek-v4-pro[1M]

# Activate tool search when tools exceed 5% of context
ENABLE_TOOL_SEARCH=auto:5

# ── Dify plugin remote install (for local debugging) ──────────────
INSTALL_METHOD=remote
REMOTE_INSTALL_URL=debug.dify.ai:5003
REMOTE_INSTALL_KEY=********-****-****-****-************



